---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';

// Swap the file below to change the logo. It already includes the company
// name as artwork, so no text is rendered beside it.
import logo from '~/assets/images/dayi_logo_logo-with-text.png';

// Render the whole PNG at its natural aspect ratio, sized by height.
const logoHeight = 68;
const logoWidth = Math.round((logo.width / logo.height) * logoHeight);
---

<span class="flex items-center self-center whitespace-nowrap">
  <Image
    src={logo}
    alt={SITE?.name}
    width={logoWidth}
    height={logoHeight}
    layout="fixed"
    class="h-17 w-auto object-contain"
    loading="eager"
  />
</span>
