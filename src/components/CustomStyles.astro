---
// Brand colours and fonts, in one place.
//
// Font family comes from Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*`.
//
// Colours below feed the Tailwind theme (`src/assets/styles/tailwind.css`):
// `text-primary`, `bg-primary`, `btn-primary`, `text-muted` and so on.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    /* [REPLACE] with the company's brand colours. */
    --aw-color-primary: rgb(100 147 232); /* blue — buttons, links, icons */
    --aw-color-secondary: rgb(28 54 100); /* darker blue — hover states */
    --aw-color-accent: rgb(30 58 95); /* deep navy — occasional emphasis */

    --aw-color-text-heading: rgb(15 23 32);
    --aw-color-text-default: rgb(28 38 48);
    --aw-color-text-muted: rgb(28 38 48 / 68%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(11 18 23);

    ::selection {
      background-color: rgb(13 122 128 / 20%);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(45 168 173);
    --aw-color-secondary: rgb(31 143 148);
    --aw-color-accent: rgb(125 172 224);

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(226 234 240);
    --aw-color-text-muted: rgb(226 234 240 / 68%);
    --aw-color-bg-page: rgb(11 18 23);

    ::selection {
      background-color: rgb(45 168 173 / 30%);
    }
  }
</style>
