---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  badge,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
  fullHeight = false,
} = Astro.props;

// `image.aspect: 'auto'` shows the picture whole (transparent illustrations);
// the default crops it to the hero frame.
const { aspect: imageAspect, ...imageProps } = typeof image === 'object' && image ? image : { src: '', alt: '' };
const imageWhole = imageAspect === 'auto';
---

<!-- 93px = header height: py-3 (24px) + logo (68px) + 1px border. Keep in sync with Logo.astro. --><!-- `fullHeight`: the section fills the window. On desktop it is pulled up under the
     sticky header, so a full viewport covers it; on mobile it starts below the header,
     so that height comes off the top. It fills the whole window. -->
<section
  class:list={['relative md:-mt-[93px] not-prose', fullHeight && 'flex min-h-[calc(100dvh-93px)] md:min-h-dvh']}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class:list={['relative max-w-7xl mx-auto px-4 sm:px-6', fullHeight && 'flex w-full flex-col justify-center']}>
    <div class="pt-0 md:pt-[93px] pointer-events-none"></div>
    <!-- Full-height heroes carry extra bottom padding so the centred text sits above
         the middle, clear of the artwork along the bottom edge. -->
    <div class:list={[fullHeight ? 'pt-8 pb-32 md:pt-12 md:pb-56' : 'py-12 md:py-20']}>
      <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
        {
          badge && (
            <span class="inline-block mb-4 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary dark:bg-primary/25 dark:text-blue-200 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
              {badge}
            </span>
          )
        }
        {
          tagline && (
            <p
              class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class="text-5xl md:text-6xl font-bold leading-[1.2] tracking-tighter mb-6 font-heading text-heading intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl mx-auto">
          {
            subtitle && (
              <p
                class="text-xl md:text-2xl font-medium leading-relaxed text-default mb-6 dark:text-slate-200 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
                set:html={subtitle}
              />
            )
          }
          {
            actions && (!Array.isArray(actions) || actions.length > 0) && (
              <div class="max-w-xs sm:max-w-xl m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 sm:gap-8 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0 rounded-none" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      <div
        class="intersect-once intersect-no-queue intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
      >
        {
          image && (
            <div class="relative m-auto max-w-5xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class:list={[
                    'mx-auto',
                    imageWhole ? 'w-auto max-h-[32rem] object-contain md:max-h-[44rem]' : 'rounded-md w-full',
                  ]}
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  fetchpriority="high"
                  {...(imageWhole ? { inferSize: true, layout: 'none' } : { width: 1024, height: 576 })}
                  format="webp"
                  {...imageProps}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
  {
    Astro.slots.has('bottom') && (
      <div class="absolute inset-x-0 bottom-8 md:bottom-12 flex justify-center">
        <slot name="bottom" />
      </div>
    )
  }
</section>
