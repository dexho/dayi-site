---
import Layout from '~/layouts/PageLayout.astro';

import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

import { getContent } from '~/utils/content';
import { md, mdInline } from '~/utils/markdown';

// Same mountain art as the last section of the landing page.
import contactBackdrop from '~/assets/images/AdobeStock_562963511 [Converted]-2.png';

// Copy lives in src/content/pages/contact.md; the addresses below come from
// src/content/site.md so they are only written once.
const page = await getContent('contact');
const { title, description, contact } = page.data;

const site = await getContent('site');
const { email, phone, address } = site.data.contact;
---

<Layout metadata={{ title, description }}>
  <!-- Contact: addresses come from src/content/site.md -->
  <WidgetWrapper id="contact" containerClass="max-w-4xl mx-auto">
    <Fragment slot="bg">
      <Image
        src={contactBackdrop}
        alt=""
        class="contact-art"
        widths={[800, 1280, 1920, 2560]}
        width={2560}
        sizes="100vw"
        format="webp"
        layout="none"
        loading="lazy"
      />
    </Fragment>

    <!-- Each line of text sits on a page-coloured highlight (like the landing
         page's contact section) so the art doesn't run through the words. -->
    <Headline
      tagline={await mdInline(contact?.tagline)}
      title={contact?.title && `<span class="contact-highlight">${await mdInline(contact.title)}</span>`}
      classes={{ container: 'max-w-3xl mb-6 md:mb-6' }}
    />

    {
      // Same text style and width as the intro on the platform page.
      contact?.subtitle && (
        <p class="mx-auto mb-8 md:mb-12 max-w-xl text-left text-base md:text-lg font-medium leading-relaxed text-default dark:text-slate-200">
          <span class="contact-highlight" set:html={await mdInline(contact.subtitle)} />
        </p>
      )
    }

    <div class="mx-auto flex max-w-md flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <Button variant="primary" href={`mailto:${email}`} text={email} />
    </div>

    {
      (phone || address) && (
        <dl class="mx-auto mt-10 grid max-w-2xl gap-8 text-center sm:grid-cols-2 sm:text-left">
          {phone && (
            <div>
              <dt class="text-sm font-semibold tracking-wide text-heading uppercase">Phone</dt>
              <dd class="mt-1 text-muted">
                <a class="hover:text-primary hover:underline" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>
                  {phone}
                </a>
              </dd>
            </div>
          )}
          {address && (
            <div>
              <dt class="text-sm font-semibold tracking-wide text-heading uppercase">Address</dt>
              <dd class="mt-1 whitespace-pre-line text-muted">{address.trim()}</dd>
            </div>
          )}
        </dl>
      )
    }
  </WidgetWrapper>
</Layout>

<style>
  /* Matches .story-tint-art on the landing page: full width along the bottom,
     inverted and faded. */
  :global(.contact-art) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    max-width: none;
    height: auto;
    mix-blend-mode: luminosity;
    filter: invert(1);
    opacity: 0.25;
    clip-path: inset(2px 0 0 0);
  }
  /* The button is filled with the page colour so the art doesn't show through. */
  /* The section fills the space above the footer, so the art sits right on the
     footer line instead of floating above leftover space on tall windows. */
  :global(main:has(> #contact)) {
    display: flex;
    flex-direction: column;
  }
  :global(main > #contact) {
    flex: 1;
  }
  :global(#contact .btn-primary) {
    background-color: var(--aw-color-bg-page);
  }
  /* Matches .story-highlight in the landing page's contact section. */
  :global(.contact-highlight) {
    background-color: var(--aw-color-bg-page);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0.1em 0.3em;
    margin: 0 -0.3em;
  }
</style>
