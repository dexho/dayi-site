---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Image from '~/components/common/Image.astro';
import Prose from '~/components/ui/Prose.astro';
import Button from '~/components/ui/Button.astro';

import { SITE } from 'astrowind:config';
import { getContent, hasBodyContent } from '~/utils/content';
import { findImage } from '~/utils/images';
import { md, mdInline, mdItems } from '~/utils/markdown';
import { render } from 'astro:content';
import favIconSvg from '~/assets/favicons/favicon.svg';

// All copy lives in src/content/pages/home.md — nothing on this page is hardcoded.
const page = await getContent('home');
const { title, description, hero, mission, platform, approach, stats, cta } = page.data;
// The closing call to action is the story's third step, worded like the others.
const contact = cta && { tagline: cta.title, text: cta.subtitle ?? '', action: undefined };
// Email, phone and address for the contact step come from src/content/site.md.
const site = await getContent('site');
const { email, phone, address } = site.data.contact;
// Hero backdrop (set in home.md as `hero.backdrop`). Resolved here so the srcset
// fits whatever artwork is dropped in: variants wider than the file itself would
// only upscale it, so the file's own width caps the list. Nothing wider than 2560px
// is served, however large the source file is.
const BACKDROP_WIDTHS = [640, 960, 1280, 1920, 2560];
const backdrop = hero.backdrop ? await findImage(hero.backdrop.src) : null;
const backdropWidth = backdrop && typeof backdrop === 'object' ? backdrop.width : undefined;
const backdropWidths =
  backdropWidth && backdropWidth < 2560
    ? [...BACKDROP_WIDTHS.filter((w) => w < backdropWidth), backdropWidth]
    : BACKDROP_WIDTHS;

const { Content: Body } = await render(page);
const hasBody = hasBodyContent(page.body);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE?.site}/#organization`,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    description,
  },
];
---

<Layout metadata={{ title, description, ignoreTitleTemplate: true }}>
  <StructuredData slot="head" schema={structuredData} />

  <Hero
    id="top"
    fullHeight
    badge={hero.badge}
    tagline={await mdInline(hero.tagline)}
    title={await mdInline(hero.title)}
    subtitle={await md(hero.subtitle)}
    actions={hero.actions}
    image={hero.image}
  >
    {
      hero.scrollCue && mission && (
        <Fragment slot="overlay">
          <!-- The bottom third of the splash is a big invisible version of the arrow:
               clicking anywhere in it scrolls to the mission too. Hidden from keyboard
               and screen readers, which already have the arrow link. -->
          <a
            href="#mission"
            class="absolute inset-x-0 bottom-0 h-1/3 cursor-pointer"
            tabindex="-1"
            aria-hidden="true"></a>
        </Fragment>
      )
    }
    {
      hero.scrollCue && mission && (
        <Fragment slot="cue">
          <!-- Wavy down-arrow, drawn in pixels. It sits right under the subtitle (see
               the "cue" slot in Hero.astro); its first 240px are a straight line that
               the -240px top margin pulls back up behind the subtitle box; another
               16px of straight line shows below the box before the three peaks.
               Hero.astro trims whatever reaches above the title. A brighter segment
               flows down the whole length on a loop. Keep the margin in .scroll-cue at
               240px if the straight top (V256 = 240 + 16) changes. -->
          <!-- <cue-sweep> (script below) pins the arrow in the window as the page
               scrolls and collapses it from both ends towards the middle. -->
          <cue-sweep>
          <a href="#mission" class="scroll-cue" aria-label={hero.scrollCue}>
            <svg width="48" height="370" viewBox="0 0 48 370" fill="none" aria-hidden="true">
              <path
                class="scroll-cue-track"
                d="M24 0 V256 q22 8 0 16 t0 16 t0 16 t0 16 t0 16 t0 16 V368 M14 358 L24 368 L34 358"
              />
              <path
                class="scroll-cue-flow"
                pathLength="100"
                d="M24 0 V256 q22 8 0 16 t0 16 t0 16 t0 16 t0 16 t0 16 V368"
              />
            </svg>
          </a>
          </cue-sweep>
        </Fragment>
      )
    }
    <Fragment slot="bg">
      <!-- Extends up behind the header (which isn't pulled over on mobile) so the fill starts at the very top. -->
      <div class="hero-sand absolute inset-x-0 bottom-0 -top-[93px] md:top-0">
        {
          backdrop && (
            <div class="hero-backdrop-window absolute inset-0">
              <Image
                src={backdrop}
                alt={hero.backdrop?.alt ?? ''}
                class="hero-backdrop fixed inset-x-0 bottom-0 h-auto max-h-[60dvh] object-cover object-bottom"
                widths={backdropWidths}
                width={backdropWidths[backdropWidths.length - 1]}
                sizes="100vw"
                format="webp"
                layout="none"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )
        }
      </div>
    </Fragment>
  </Hero>

  <!-- Opaque surface for everything below the hero: the backdrop is pinned to the
       viewport, so the sections scrolling over it need a background of their own to
       hide it. `relative` matters as much as the colour — a static block paints below
       positioned elements, and the pinned artwork is one. -->
  <!-- `isolate` keeps section backgrounds (drawn one layer back, at -z-1) above this
       surface instead of behind it. -->
  <div class="relative isolate bg-page">
    {
      // Mission, platform and contact as a scroll story. Each statement fills the
      // window and the page snaps from one to the next (see the scroll-snap rules
      // below). The graphic stays pinned (sticky) and changes as each statement
      // reaches the middle of the window: it drops in as a 3 × 3 grid for the
      // mission, folds into the single red dot for the platform, then shrinks away
      // for the contact step, which has its own red envelope above its heading.
      // The graphic is pinned near the top centre, and each step's text starts
      // just below it (the step's top padding matches the graphic's offset plus
      // its height). Headers are centred; the paragraphs are left-aligned. The first
      // step keeps the #mission id: it is where the hero's arrow scrolls to.
      (mission || platform || contact) && (
        <story-steps class="story block overflow-x-clip px-4 sm:px-6" data-step="before">
          <div class="mx-auto w-full max-w-5xl">
            <div class="story-visual pointer-events-none sticky top-[calc(93px+4svh)] z-10 -mb-32 flex h-32 items-center justify-center md:top-[calc(93px+14svh)] md:-mb-36 md:h-36">
              <svg class="w-full max-w-[6rem] md:max-w-[8rem]" viewBox="0 0 120 120" fill="none" aria-hidden="true">
                {Array.from({ length: 9 }, (_, n) => {
                  const col = n % 3;
                  const row = Math.floor(n / 3);
                  const key = `${col},${row}`;
                  // Red dashed circles in the mission grid, as "column,row" from the top left.
                  const dashed = ['1,0', '0,1', '2,2'].includes(key);
                  const center = key === '1,1';
                  return (
                    <circle
                      cx={20 + col * 40}
                      cy={20 + row * 40}
                      r="16"
                      pathLength="100"
                      class:list={['dot', dashed && 'dot-dashed', center && 'dot-center']}
                      style={`--dx: ${(1 - col) * 40}px; --dy: ${(1 - row) * 40}px; --i: ${n}`}
                    />
                  );
                })}
              </svg>
            </div>

            <div>
              {[
                { band: mission, id: 'mission' },
                { band: platform, id: 'platform' },
                { band: contact, id: 'contact' },
              ].map(
                async ({ band, id }) =>
                  band && (
                    <div
                      id={id}
                      data-step={id}
                      class:list={[
                        'story-step flex flex-col items-center pb-12 text-center md:pb-16',
                        // The contact step fills what the footer leaves of the window,
                        // so its snap point is the bottom of the page: the last scroll
                        // shows the contact step and the footer together. --footer-h
                        // is measured by the script below.
                        id === 'contact'
                          ? 'story-tint min-h-[calc(100svh-93px-var(--footer-h,0px))] md:!pb-8'
                          : 'min-h-[calc(100svh-93px)]',
                        // The steps after the mission sit a little higher (the graphic
                        // lifts with them, see .story-visual svg below).
                        id === 'mission'
                          ? 'pt-[calc(4svh+9.5rem)] md:pt-[calc(14svh+11rem)]'
                          : id === 'platform'
                            ? 'pt-[calc(1svh+9.5rem)] md:pt-[calc(8svh+11rem)]'
                            : 'pt-[calc(1svh+3rem)] md:pt-[calc(8svh+3.5rem)]',
                      ]}
                    >
                      {id === 'contact' && (
                        // Red envelope above the contact heading, part of the step itself
                        // (not the pinned graphic) so it always moves with the text.
                        <svg
                          class="story-text story-mail mb-6 w-11"
                          viewBox="40 46 40 29"
                          fill="none"
                          aria-hidden="true"
                        >
                          <rect x="42" y="48" width="36" height="25" rx="2" />
                          <path d="M42.5 49.5 L60 62 L77.5 49.5" />
                        </svg>
                      )}
                      <div class="story-text">
                        {band.tagline && (
                          <h2
                            class="mb-3 text-base font-semibold uppercase tracking-[0.2em] text-primary md:mb-4 md:text-lg dark:text-blue-200"
                            set:html={await mdInline(band.tagline)}
                          />
                        )}
                        <p
                          class:list={[
                            'story-copy mx-auto max-w-xl text-lg md:text-xl font-normal leading-relaxed text-default dark:text-slate-200',
                            // Mission and platform read as paragraphs (left-aligned); the
                            // short contact line is centred like its heading.
                            id === 'contact' ? 'text-center' : 'text-left',
                          ]}
                          set:html={await mdInline(band.text)}
                        />
                      </div>
                      {band.action && (
                        <div class="story-text story-text-late mt-10">
                          <Button variant="primary" {...band.action} class="text-lg" />
                        </div>
                      )}
                      {id === 'contact' && (
                        <div class="story-text story-text-late mt-8 flex flex-col items-center">
                          <Button variant="primary" href={`mailto:${email}`} text={email} icon="tabler:mail" class="text-lg" />
                          {(phone || address) && (
                            <dl class="mt-8 grid gap-6 text-center text-sm sm:grid-cols-2 sm:gap-16">
                              {phone && (
                                <div>
                                  <dt class="font-semibold uppercase tracking-wide text-heading">Phone</dt>
                                  <dd class="mt-1 text-muted">
                                    <a class="hover:text-primary hover:underline" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>
                                      {phone}
                                    </a>
                                  </dd>
                                </div>
                              )}
                              {address && (
                                <div>
                                  <dt class="font-semibold uppercase tracking-wide text-heading">Address</dt>
                                  <dd class="mt-1 text-muted">
                                    {address
                                      .trim()
                                      .split('\n')
                                      .map((line) => (
                                        <span class="block">{line}</span>
                                      ))}
                                  </dd>
                                </div>
                              )}
                            </dl>
                          )}
                        </div>
                      )}
                    </div>
                  )
              )}
            </div>
          </div>
        </story-steps>
      )
    }

    {
      approach && (
        <Content
          isReversed
          tagline={await mdInline(approach.tagline)}
          title={await mdInline(approach.title)}
          subtitle={await md(approach.subtitle)}
          content={await md(approach.content)}
          items={await mdItems(approach.items)}
          image={approach.image}
        >
          <Fragment slot="bg">
            <div class="absolute inset-0 bg-primary/5 dark:bg-transparent" />
          </Fragment>
        </Content>
      )
    }

    {
      stats && (
        <Stats countUp title={await mdInline(stats.title)} subtitle={await md(stats.subtitle)} stats={stats.items} />
      )
    }

    {
      hasBody && (
        <Prose>
          <Body />
        </Prose>
      )
    }

  </div>
</Layout>

<script>
  // The hero's wavy arrow stays put in the window while the page scrolls under it,
  // and collapses from both ends at once: the tail wipes down while the arrowhead
  // wipes up, meeting in the middle. It is gone halfway to the point where the page
  // surface below the hero would reach the arrowhead (or the mission section reaches
  // its scroll target, if sooner), so nothing ever covers the arrow.
  // Clicking the arrow (or the click zone along the hero's bottom) scrolls smoothly,
  // so the wipe plays out instead of the arrow vanishing in one jump.
  class CueSweep extends HTMLElement {
    private link?: HTMLAnchorElement;
    private svg?: SVGSVGElement;
    private frame?: HTMLElement;
    private target?: HTMLElement;
    private triggers: HTMLAnchorElement[] = [];
    /** Arrow-local y where the visible line starts at rest (the frame's top edge). */
    private tailStart = 0;
    private height = 0;
    /** Latest scroll distance the collapse may run to; it actually ends at half. */
    private end = 1;
    private raf = 0;

    connectedCallback() {
      this.link = this.querySelector('a') ?? undefined;
      this.svg = this.link?.querySelector('svg') ?? undefined;
      this.frame = this.closest<HTMLElement>('[data-cue-frame]') ?? undefined;
      const hash = this.link?.hash;
      this.target = (hash && document.getElementById(hash.slice(1))) || undefined;
      if (!this.link || !this.svg || !this.frame || !this.target || !hash) return;

      this.measure();
      this.update();
      // The frame used to trim the line at the title; the clip on the arrow does
      // that now, and the frame must not cut off the arrow as it stays behind.
      this.frame.style.overflow = 'visible';

      window.addEventListener('scroll', this.onScroll, { passive: true });
      window.addEventListener('resize', this.onResize);
      document.fonts?.ready.then(this.onResize);

      this.triggers = [...document.querySelectorAll<HTMLAnchorElement>(`a[href="${hash}"]`)];
      this.triggers.forEach((a) => a.addEventListener('click', this.onClick));
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScroll);
      window.removeEventListener('resize', this.onResize);
      this.triggers.forEach((a) => a.removeEventListener('click', this.onClick));
      cancelAnimationFrame(this.raf);
    }

    private measure() {
      const { link, svg, frame, target } = this;
      if (!link || !svg || !frame || !target) return;
      link.style.transform = '';
      const sy = window.scrollY;
      const box = svg.getBoundingClientRect();
      this.tailStart = Math.max(0, frame.getBoundingClientRect().top - box.top);
      this.height = box.height;
      const surfaceTop = target.getBoundingClientRect().top + sy;
      const scrollTarget =
        surfaceTop - (parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0);
      const headAtRest = box.bottom + sy;
      this.end = Math.max(1, Math.min(surfaceTop - headAtRest, scrollTarget));
    }

    private update() {
      const { link, svg } = this;
      if (!link || !svg) return;
      // Each end moves as fast as a single wipe over `end` would, so meeting in the
      // middle takes half the distance.
      const span = this.end / 2;
      const s = Math.min(Math.max(window.scrollY, 0), span);
      const p = s / span;
      const mid = (this.tailStart + this.height) / 2;
      const top = this.tailStart + p * (mid - this.tailStart);
      const bottom = p * (this.height - mid);
      link.style.transform = s ? `translateY(${s}px)` : '';
      svg.style.clipPath = `inset(${top}px 0 ${bottom}px 0)`;
      link.style.visibility = p >= 1 ? 'hidden' : '';
    }

    private onScroll = () => {
      cancelAnimationFrame(this.raf);
      this.raf = requestAnimationFrame(() => this.update());
    };

    private onResize = () => {
      this.measure();
      this.update();
    };

    private onClick = (e: MouseEvent) => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.target?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    };
  }

  if (!customElements.get('cue-sweep')) customElements.define('cue-sweep', CueSweep);

  // Scroll story for mission and platform: whichever step crosses the middle of
  // the window becomes the active one, and its name goes on the element as
  // data-step, which the CSS uses to change the circle graphic and show that
  // step's text. Above the first step the state is "before" (graphic lifted
  // away), so it drops in as the mission arrives; below the last it is "after"
  // (graphic faded out).
  class StorySteps extends HTMLElement {
    private steps: HTMLElement[] = [];
    private raf = 0;

    connectedCallback() {
      this.steps = [...this.querySelectorAll<HTMLElement>('[data-step]')];
      if (!this.steps.length) return;
      window.addEventListener('scroll', this.onScroll, { passive: true });
      window.addEventListener('resize', this.onResize);
      this.measure();
      this.update();
      this.toggleAttribute('data-ready', true);
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScroll);
      window.removeEventListener('resize', this.onResize);
      cancelAnimationFrame(this.raf);
      document.documentElement.style.removeProperty('--footer-h');
    }

    // The contact step fills what the footer leaves of the window, so it needs
    // the footer's height; that only changes on resize, not while scrolling.
    private measure() {
      const footer = document.querySelector('footer');
      if (footer) document.documentElement.style.setProperty('--footer-h', `${footer.offsetHeight}px`);
    }

    private onResize = () => {
      this.measure();
      this.onScroll();
    };

    private onScroll = () => {
      cancelAnimationFrame(this.raf);
      this.raf = requestAnimationFrame(() => this.update());
    };

    // The active step changes as soon as a scroll starts towards the next one,
    // so the pinned graphic is gone before the outgoing text slides under it:
    // going down, a step takes over once its top is SWITCH px into the window;
    // going up, the previous step takes over once the current one has dropped
    // SWITCH px below where it snaps. The first step is the exception: it only
    // starts once it reaches the middle of the window, so the grid's drop-in
    // plays in view. Once the last step is pushed well up past where it snaps
    // (the footer coming into view), the story is over and the graphic fades.
    private lastY = window.scrollY;

    private update() {
      const middle = window.innerHeight / 2;
      const snapTop = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      const SWITCH = 40;
      const down = window.scrollY >= this.lastY;
      this.lastY = window.scrollY;
      let active: HTMLElement | undefined;
      this.steps.forEach((step, i) => {
        const line = i === 0 ? middle : down ? window.innerHeight - SWITCH : snapTop + SWITCH;
        if (step.getBoundingClientRect().top <= line) active = step;
      });
      const last = this.steps.at(-1)!;
      let state = active?.dataset.step ?? 'before';
      if (active === last && last.getBoundingClientRect().top < snapTop - 80) state = 'after';
      if (this.dataset.step !== state) this.dataset.step = state;
    }
  }

  if (!customElements.get('story-steps')) customElements.define('story-steps', StorySteps);
</script>

<style>
  cue-sweep {
    display: block;
  }

  /* Centred under the subtitle; the negative margin pulls the 240px straight top
     of the drawing back up behind the subtitle box (see the markup above). */
  .scroll-cue svg {
    display: block;
    overflow: visible;
  }
  /* Brand navy line (same colour as the hero's divider dash in Hero.astro). The flowing
     segment is a brighter blue, so it reads as a glint travelling down. */
  .scroll-cue {
    display: block;
    width: fit-content;
    margin: -240px auto 0;
    --cue-color: var(--brand-navy);
    transition: opacity 0.2s;
  }
  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    opacity: 0.8;
  }
  .scroll-cue path {
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .scroll-cue-track {
    stroke: var(--cue-color);
  }
  /* The flowing segment: one dash, 12% of the line long, that travels from above
     the top to past the arrowhead, over and over. */
  .scroll-cue .scroll-cue-flow {
    stroke: #367add;
    stroke-dasharray: 12 100;
    stroke-dashoffset: 12;
    animation: scroll-cue-flow 2.4s linear infinite;
  }
  @keyframes scroll-cue-flow {
    to {
      stroke-dashoffset: -100;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue .scroll-cue-flow {
      animation: none;
    }
  }

  /* Circle grid beside the mission: navy outlines like the hero arrow, a few
     dots filled in the hero sun's red. */
  .dot {
    stroke: var(--brand-navy);
    stroke-width: 1.5;
  }
  /* pathLength="100" on each circle makes this ten even dashes all the way round. */
  .dot-dashed {
    stroke: var(--brand-red);
    stroke-dasharray: 6 4;
  }
  :global(.dark) .dot:not(.dot-dashed),
  :global(.dark) .story-mail {
    stroke: var(--color-slate-400);
  }

  /* Page-wide scroll snapping, only while this page is shown: each scroll lands
     on the hero or a story step. The padding keeps
     snapped content clear of the sticky header (93px). Steps taller than the
     window still scroll freely inside. */
  :global(html:has(story-steps)) {
    scroll-snap-type: y mandatory;
    scroll-padding-top: 93px;
  }
  :global(#top),
  .story-step {
    scroll-snap-align: start;
  }
  /* The very bottom too, so a footer taller than the space left under the call
     to action can still be scrolled into view. */
  :global(html:has(story-steps) footer) {
    scroll-snap-align: end;
  }

  /* The story is sized in svh (the window height with the phone's browser bars
     showing), not dvh: dvh changes as the bars slide in and out while
     scrolling, which would resize the steps mid-scroll and fight the snapping.

     Circle graphic states (data-step on <story-steps>). Every circle scales and
     moves around its own centre; --dx/--dy point it at the middle circle. */
  .dot {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.5s ease,
      fill 0.4s ease,
      stroke 0.4s ease;
    transition-delay: calc(var(--i) * 40ms);
  }
  /* Before the mission: lifted above and hidden, ready to drop in. */
  story-steps[data-ready][data-step='before'] .dot {
    opacity: 0;
    transform: translateY(-60px);
  }
  /* Past the last step (scrolled on to the footer): the graphic fades away, but
     the contact text stays, as it is still in view. */
  story-steps[data-step='after'] .story-visual {
    opacity: 0;
  }
  .story-visual {
    transition: opacity 0.4s ease;
  }
  /* The platform step sits higher than the mission (its top padding is smaller
     by the same amount), so the graphic rises with it. */
  .story-visual svg {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  story-steps:is([data-step='platform'], [data-step='contact'], [data-step='after']) .story-visual svg {
    transform: translateY(-3svh);
  }
  @media (min-width: 768px) {
    story-steps:is([data-step='platform'], [data-step='contact'], [data-step='after']) .story-visual svg {
      transform: translateY(-6svh);
    }
  }
  /* Platform: the grid folds into the middle circle, which turns solid red. */
  story-steps[data-step='platform'] .dot:not(.dot-center) {
    opacity: 0;
    transform: translate(var(--dx), var(--dy)) scale(0.2);
    /* Leaving is quick, so the grid clears before the text scrolls under it. */
    transition:
      transform 0.3s ease-in,
      opacity 0.2s ease-in;
  }
  story-steps[data-step='platform'] .dot.dot-center {
    fill: var(--brand-red);
    stroke: var(--brand-red);
    transition-delay: 250ms;
  }

  /* Contact: every circle, the red dot too, shrinks away into the middle; the
     step's own envelope (above its heading) takes over. */
  story-steps:is([data-step='contact'], [data-step='after']) .dot {
    opacity: 0;
    transform: translate(var(--dx), var(--dy)) scale(0);
    transition:
      transform 0.3s ease-in,
      opacity 0.2s ease-in;
  }
  /* Contact gets the same light blue tint the old call-to-action band had,
