---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Prose from '~/components/ui/Prose.astro';

import { SITE } from 'astrowind:config';
import { getContent } from '~/utils/content';
import { md, mdInline, mdItems } from '~/utils/markdown';
import { render } from 'astro:content';
import favIconSvg from '~/assets/favicons/favicon.svg';

// All copy lives in src/content/pages/home.md — nothing on this page is hardcoded.
const page = await getContent('home');
const { title, description, hero, highlights, approach, stats, cta } = page.data;
const { Content: Body } = await render(page);
const hasBody = Boolean(page.body?.trim());

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE?.site}/#organization`,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    description,
  },
];
---

<Layout metadata={{ title, description, ignoreTitleTemplate: true }}>
  <StructuredData slot="head" schema={structuredData} />

  <Hero
    badge={hero.badge}
    tagline={await mdInline(hero.tagline)}
    title={await mdInline(hero.title)}
    subtitle={await md(hero.subtitle)}
    actions={hero.actions}
    image={hero.image}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5"></div>
    </Fragment>
  </Hero>

  {
    highlights && (
      <Features
        id="highlights"
        columns={3}
        tagline={await mdInline(highlights.tagline)}
        title={await mdInline(highlights.title)}
        subtitle={await md(highlights.subtitle)}
        items={await mdItems(highlights.items)}
      />
    )
  }

  {
    approach && (
      <Content
        isReversed
        tagline={await mdInline(approach.tagline)}
        title={await mdInline(approach.title)}
        subtitle={await md(approach.subtitle)}
        content={await md(approach.content)}
        items={await mdItems(approach.items)}
        image={approach.image}
      >
        <Fragment slot="bg">
          <div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div>
        </Fragment>
      </Content>
    )
  }

  {
    stats && (
      <Stats
        countUp
        title={await mdInline(stats.title)}
        subtitle={await md(stats.subtitle)}
        stats={stats.items}
      />
    )
  }

  {
    hasBody && (
      <Prose>
        <Body />
      </Prose>
    )
  }

  {
    cta && (
      <CallToAction
        title={await mdInline(cta.title)}
        subtitle={await md(cta.subtitle)}
        actions={cta.actions}
      />
    )
  }
</Layout>
