---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Image from '~/components/common/Image.astro';
import Prose from '~/components/ui/Prose.astro';

import { SITE } from 'astrowind:config';
import { getContent } from '~/utils/content';
import { findImage } from '~/utils/images';
import { md, mdInline, mdItems } from '~/utils/markdown';
import { render } from 'astro:content';
import favIconSvg from '~/assets/favicons/favicon.svg';

// All copy lives in src/content/pages/home.md — nothing on this page is hardcoded.
const page = await getContent('home');
const { title, description, hero, mission, approach, stats, cta } = page.data;
// Hero backdrop (set in home.md as `hero.backdrop`). Resolved here so the srcset
// fits whatever artwork is dropped in: variants wider than the file itself would
// only upscale it, so the file's own width caps the list. Nothing wider than 2560px
// is served, however large the source file is.
const BACKDROP_WIDTHS = [640, 960, 1280, 1920, 2560];
const backdrop = hero.backdrop ? await findImage(hero.backdrop.src) : null;
const backdropWidth = backdrop && typeof backdrop === 'object' ? backdrop.width : undefined;
const backdropWidths =
  backdropWidth && backdropWidth < 2560
    ? [...BACKDROP_WIDTHS.filter((w) => w < backdropWidth), backdropWidth]
    : BACKDROP_WIDTHS;

const { Content: Body } = await render(page);
const hasBody = Boolean(page.body?.trim());

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE?.site}/#organization`,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    description,
  },
];
---

<Layout metadata={{ title, description, ignoreTitleTemplate: true }}>
  <StructuredData slot="head" schema={structuredData} />

  <Hero
    fullHeight
    badge={hero.badge}
    tagline={await mdInline(hero.tagline)}
    title={await mdInline(hero.title)}
    subtitle={await md(hero.subtitle)}
    actions={hero.actions}
    image={hero.image}
  >
    {
      hero.scrollCue && mission && (
        <Fragment slot="overlay">
          <!-- The bottom quarter of the splash is a big invisible version of the arrow:
               clicking anywhere in it scrolls to the mission too. Hidden from keyboard
               and screen readers, which already have the arrow link. -->
          <a
            href="#mission"
            class="absolute inset-x-0 bottom-0 h-1/4 cursor-pointer"
            tabindex="-1"
            aria-hidden="true"></a>
        </Fragment>
      )
    }
    {
      hero.scrollCue && mission && (
        <Fragment slot="cue">
          <!-- Wavy down-arrow, drawn in pixels. It sits right under the subtitle (see
               the "cue" slot in Hero.astro); its first 240px are a straight line that
               the -240px top margin pulls back up behind the subtitle box; another
               16px of straight line shows below the box before the three peaks.
               Hero.astro trims whatever reaches above the title. A brighter segment
               flows down the whole length on a loop. Keep the margin in .scroll-cue at
               240px if the straight top (V256 = 240 + 16) changes. -->
          <a href="#mission" class="scroll-cue" aria-label={hero.scrollCue}>
            <svg width="48" height="370" viewBox="0 0 48 370" fill="none" aria-hidden="true">
              <path
                class="scroll-cue-track"
                d="M24 0 V256 q22 8 0 16 t0 16 t0 16 t0 16 t0 16 t0 16 V368 M14 358 L24 368 L34 358"
              />
              <path
                class="scroll-cue-flow"
                pathLength="100"
                d="M24 0 V256 q22 8 0 16 t0 16 t0 16 t0 16 t0 16 t0 16 V368"
              />
            </svg>
          </a>
        </Fragment>
      )
    }
    <Fragment slot="bg">
      <!-- Extends up behind the header (which isn't pulled over on mobile) so the fill starts at the very top. -->
      <div class="hero-sand absolute inset-x-0 bottom-0 -top-[93px] md:top-0">
        {
          backdrop && (
            <div class="hero-backdrop-window absolute inset-0">
              <Image
                src={backdrop}
                alt={hero.backdrop?.alt ?? ''}
                class="hero-backdrop fixed inset-x-0 bottom-0 h-auto max-h-[60dvh] object-cover object-bottom"
                widths={backdropWidths}
                width={backdropWidths[backdropWidths.length - 1]}
                sizes="100vw"
                format="webp"
                layout="none"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )
        }
      </div>
    </Fragment>
  </Hero>

  <!-- Opaque surface for everything below the hero: the backdrop is pinned to the
       viewport, so the sections scrolling over it need a background of their own to
       hide it. `relative` matters as much as the colour — a static block paints below
       positioned elements, and the pinned artwork is one. -->
  <div class="relative bg-page">
    {
      mission && (
        <section id="mission" class="flex items-center justify-center px-4 sm:px-6">
          <div class="max-w-3xl text-center intersect-once intersect-half motion-safe:opacity-0 motion-safe:intersect:animate-fade">
            {
              mission.tagline && (
                <h2
                  class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-primary dark:text-blue-200"
                  set:html={await mdInline(mission.tagline)}
                />
              )
            }
            <p
              class="text-xl md:text-2xl font-normal leading-relaxed text-default dark:text-slate-200"
              set:html={await mdInline(mission.text)}
            />
          </div>
        </section>
      )
    }

    {
      approach && (
        <Content
          isReversed
          tagline={await mdInline(approach.tagline)}
          title={await mdInline(approach.title)}
          subtitle={await md(approach.subtitle)}
          content={await md(approach.content)}
          items={await mdItems(approach.items)}
          image={approach.image}
        >
          <Fragment slot="bg">
            <div class="absolute inset-0 bg-primary/5 dark:bg-transparent" />
          </Fragment>
        </Content>
      )
    }

    {
      stats && (
        <Stats countUp title={await mdInline(stats.title)} subtitle={await md(stats.subtitle)} stats={stats.items} />
      )
    }

    {
      hasBody && (
        <Prose>
          <Body />
        </Prose>
      )
    }

    {cta && <CallToAction title={await mdInline(cta.title)} subtitle={await md(cta.subtitle)} actions={cta.actions} />}
  </div>
</Layout>

<style>
  /* Centred under the subtitle; the negative margin pulls the 240px straight top
     of the drawing back up behind the subtitle box (see the markup above). */
  .scroll-cue svg {
    display: block;
    overflow: visible;
  }
  /* Navy line (same colour as the hero's divider dash in Hero.astro). The flowing
     segment is a brighter blue, so it reads as a glint travelling down. */
  .scroll-cue {
    display: block;
    width: fit-content;
    margin: -240px auto 0;
    --cue-color: #173765;
    transition: opacity 0.2s;
  }
  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    opacity: 0.8;
  }
  .scroll-cue path {
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .scroll-cue-track {
    stroke: var(--cue-color);
  }
  /* The flowing segment: one dash, 12% of the line long, that travels from above
     the top to past the arrowhead, over and over. */
  .scroll-cue .scroll-cue-flow {
    stroke: #367add;
    stroke-dasharray: 12 100;
    stroke-dashoffset: 12;
    animation: scroll-cue-flow 2.4s linear infinite;
  }
  @keyframes scroll-cue-flow {
    to {
      stroke-dashoffset: -100;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue .scroll-cue-flow {
      animation: none;
    }
  }

  /* The hero's scroll cue jumps here; land below the sticky header (93px). */
  #mission {
    min-height: 30dvh;
    scroll-margin-top: 93px;
  }

  /* The artwork's own sky doubles as the section's fill, so the area behind the
     band reads as more of the same picture rather than a block behind it, and it
     lifts to the page's white at the top of the window. Repoint --hero-sand at the
     replacement artwork's sky colour when the image in home.md changes.

     The sand is fully in by 35%, which clears any artwork: the band is capped at
     60dvh, so its top edge can never rise above 40% of the section. The flat
     colour underneath is the fallback if the gradient can't be painted.

     The top 93px (the header's height) stay solid page colour, so the transparent
     header at the top matches the solid one it turns into on scroll — no pop. */
  .hero-sand {
    --hero-sand: #eae3df; /* also the subtitle box fill in Hero.astro */

    background-color: var(--hero-sand);
    background-image: linear-gradient(to bottom, var(--aw-color-bg-page) 93px, var(--hero-sand) 35%);
  }

  /* The artwork is pinned to the viewport, so the page slides over it as you
     scroll. `clip` is deprecated but used deliberately: alone among the clipping
     properties it confines a position:fixed descendant without becoming its
     containing block, so the band stays stuck to the viewport yet still ends at
     this section — `overflow` doesn't clip fixed children at all, and `clip-path`
     would make the band scroll with the section again. */
  .hero-backdrop-window {
    clip: rect(0, auto, auto, 0);
  }

  /* The relative motion between the pinned artwork and the page is the effect
     itself, so drop back to a plain bottom-aligned band when motion is unwelcome. */
  @media (prefers-reduced-motion: reduce) {
    .hero-backdrop {
      position: absolute;
    }
  }

  /* Dissolve the band's top edge into the fill. Wide landscape art tends to clip
     a peak or two flat against its top edge; the fade hides that seam, and being
     a percentage it holds up at any resolution or aspect ratio. */
  .hero-backdrop {
    mask-image: linear-gradient(to bottom, transparent, #000 10%);
  }
</style>
