---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { getContent } from '~/utils/content';
import { getPermalink } from '~/utils/permalinks';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;

// Header and footer come from `src/content/site.md`, so navigation labels and
// links are editable without touching a component.
const site = await getContent('site');
const { nav, footer } = site.data;

const withPermalink = <T extends { href: string }>(entries: T[]) =>
  entries.map((entry) => ({ ...entry, href: getPermalink(entry.href) }));
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />
  <Header links={withPermalink(nav.links)} actions={withPermalink(nav.actions)} isSticky showToggleTheme />
  <main class="flex-1">
    <slot />
  </main>
  <Footer
    links={footer.columns.map(({ title, links }) => ({ title, links: withPermalink(links) }))}
    secondaryLinks={withPermalink(footer.secondaryLinks)}
    socialLinks={footer.socials}
    footNote={footer.note}
  />
</Layout>
